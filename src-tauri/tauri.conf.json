{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChaosLauncher",
  "version": "0.1.0",
  "identifier": "com.chaoslauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChaosLauncher",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "licenseFile": "../LICENSE",
    "resources": ["../LICENSE", "../README.md", "../NOTICE"]
  }
}
